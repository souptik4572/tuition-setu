# Copy to .env.local. ./setup.sh does this for the local version (SPEC §13.4).

APP_MODE=local                        # local | hosted (SPEC §19)
AI_PROVIDER=ollama                    # ollama | openai-compatible
OLLAMA_HOST=http://127.0.0.1:11434

# AI models (Ollama tags, or model ids for openai-compatible). Leave empty for the defaults in
# lib/ai/models.ts. A model named here always wins, including over B4's quality mode. Edit and
# restart TuitionSetu to swap; no rebuild needed. Pull a model first: `ollama pull <name>`.
MODEL_EXTRACT=                        # reads your notes, e.g. qwen3.5:9b (default gemma4:latest)
MODEL_DRAFT=                          # writes the parent updates (default gemma4:latest)
MODEL_VISION=                         # reads register photos, P1 (default gemma4:latest)
MODEL_QUALITY_DRAFT=                  # quality mode's larger writing model (default gemma4:e4b)
MODEL_ALTERNATES=                     # "Try the other model" for a note that couldn't be read, comma-separated, in order of preference
OPENAI_COMPAT_BASE_URL=               # hosted version's inference endpoint (SPEC §19.8)
OPENAI_COMPAT_API_KEY=
DATABASE_PATH=./data/tuition-setu.db
UPLOAD_DIR=./data/uploads
SESSION_TTL_DAYS=30                   # local mode sessions
SEED_SAMPLE=false                     # local: add sample students when setup finishes (IMPL D-25)
REPO_URL=                             # shown on the landing page and in the README install command

# Hosted mode only (SPEC §19.9)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # public by design; safe only because RLS is on everywhere
SUPABASE_SECRET_KEY=                  # server and scripts only; never NEXT_PUBLIC_
DATABASE_URL=                         # Supabase pooler connection string for Drizzle
STORAGE_BUCKET=register-photos
PREVIEW_INSTANCE=false                # true on the hackathon instance: "fictional data only" banner (SPEC §19.14)
AI_QUOTA_DRAFTS_PER_MEMBER_HOUR=30
AI_QUOTA_CALLS_PER_WORKSPACE_DAY=150
APP_URL=                              # auth redirects and invitation links
AI_PROVIDER_NAME=                     # named in the privacy notice (SPEC §19.8)
RESEND_API_KEY=                       # invitation emails (IMPL D-27, P1)
EMAIL_FROM=
